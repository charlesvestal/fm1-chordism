# the arp: Trance Arp at its 1/8, then the Clock page's rate at 1/16 (twice the steps), then clock on MIDI with no
# clock coming in (the arp keeps its own tempo, not stopped)
wait 1500
turn PRESET 13
wait 300
expect sound 14
key 7 down
wait 2000
expect arpsteps >4
expect arpsteps <9
key 7 up
wait 500
tap ARP
wait 30
tap ARP
wait 30
tap ARP
wait 30
expect page 21
turn K2 2
wait 300
key 7 down
wait 2000
expect arpsteps >16
expect arpsteps <22
key 7 up
wait 500
turn K1 1
wait 300
key 7 down
wait 2000
expect arpsteps >29
key 7 up
wait 300
# Init (an ASR envelope, so a voice never released rings for ever), the arp on, two keys: when both are let go, nothing
# sounds after the release, whichever note the arp played last
turn PRESET -14
wait 300
expect sound 0
tap ARP
wait 30
turn K1 1
wait 100
key 7 down
key 11 down
wait 1300
key 11 up
key 7 up
wait 2500
expect level0 0
expect level1 0
expect held 0
expect note0 -1
# hold on: the arp goes on after the keys are let go; hold off then: it stops, and the chord is released
turn K4 1
wait 100
key 7 down
wait 300
key 7 up
wait 1500
expect held 1
turn K4 -1
wait 2500
expect held 0
expect level0 0
